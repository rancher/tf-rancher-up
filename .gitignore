# Local .terraform directories
**/.terraform/*
**/terraform-provider*/*

# .tfstate files (contain every resource attribute, including secrets)
*.tfstate
*.tfstate.*
*.terraform*

# Plan files (contain variable values and secrets in plain text)
*.tfplan
*.tfplan.json
tfplan

# Variable files have personal secrets (tokens, passwords), so don't add them.
# Only the *.tfvars.example templates are committed.
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# SSH keys, certificates and credentials
*.pem
*.key
*-key
*-key.pub
id_rsa*
id_ed25519*
*.p12
*.pfx
.env
*.env

# Kubeconfigs written by the recipes
*kubeconfig.yaml
*.kubeconfig
*kube_config.yml*
*kube_config.yaml*

# Terraform CLI configuration (can contain API tokens)
.terraformrc
terraform.rc

# Crash log files
crash.log
crash.*.log

# RKE
rke.log

# Temporary files
**/*.swp
.DS_Store
**gke_gcloud_auth_plugin_cache**
.claude/

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

.idea
myvalues.tfvars

# Allow
!modules/distribution/gke/kubeconfig.yml.tmpl
